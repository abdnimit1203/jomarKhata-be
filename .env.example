# Jomarkhata backend — copy to .env and fill in. NEVER commit .env.
# Only secrets and server settings live here. Values the owner changes (WhatsApp number, payment
# numbers, trial days, referral rate, Telegram recipients) are edited in the dashboard (Settings).

# Server
PORT=4000
NODE_ENV=development
# Frontend origins allowed to call the API (comma-separated): local + your Vercel/production domain
CORS_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app

# MongoDB Atlas → Connect → Drivers → connection string (put your DB name before the "?")
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (case-sensitive). Default: JomarKhata
MONGODB_DB_NAME=JomarKhata

# Firebase → Project settings → Service accounts → "Generate new private key" (JSON file).
# Copy these three fields from that JSON. Keep the key on ONE line with \n, inside double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Your login email(s) — these accounts become super admin (comma-separated)
SUPER_ADMIN_EMAILS=

# Starting value only. After the first edit in the dashboard (Settings) the dashboard value wins.
TRIAL_DAYS=30

# Optional Telegram alerts (new account, payments). The bot TOKEN is a secret: keep it here.
# WHO receives the alerts (chat IDs) is set in the dashboard (Settings); the value below is only
# used until you set it there. Token from @BotFather; your chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Admin panel URL used in Telegram links, e.g. https://YOUR-APP.vercel.app/admin
ADMIN_URL=
